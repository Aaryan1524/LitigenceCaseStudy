{
  "_doc": "Per-role allowlists. 'checkout' = sparse-checkout patterns (what exists on disk). 'read'/'write' = glob paths relative to the checkout root, enforced by .claude/hooks/path_guard.py. 'bash' = allowed command prefixes. Writes to protected paths are denied for every role. Roles that must stay blind to other code (evals-data, tests) get no code execution at all.",
  "protected": [
    "CLAUDE.md",
    "docs/**",
    ".claude/**",
    ".git/**",
    "tasks/**",
    "plans/**",
    "context/**",
    "parallel-filings-brief.md"
  ],
  "common_checkout": [
    "/CLAUDE.md",
    "/requirements.txt",
    "/pytest.ini",
    "/.gitignore",
    "/.claude/settings.json",
    "/.claude/agent-settings.json",
    "/.claude/roles.json",
    "/.claude/hooks/"
  ],
  "common_read": [
    "CLAUDE.md",
    "requirements.txt",
    "pytest.ini",
    ".claude/role"
  ],
  "common_bash": [
    "git status",
    "git add",
    "git commit",
    "git diff",
    "git log --oneline",
    "ls",
    "pwd",
    "wc",
    "cd"
  ],
  "roles": {
    "api": {
      "checkout": [
        "/context/api.md",
        "/.claude/agents/api.md",
        "/app/"
      ],
      "read": [
        "context/api.md",
        ".claude/agents/api.md",
        "app/**"
      ],
      "write": [
        "app/**"
      ],
      "bash": [
        "python",
        "python3",
        "pytest",
        "python -m pytest"
      ],
      "gate": "python -c \"import app.main, app.db\""
    },
    "worker": {
      "checkout": [
        "/context/worker.md",
        "/.claude/agents/worker.md",
        "/worker/",
        "/evals/__init__.py",
        "/evals/__main__.py",
        "/app/",
        "/extractor/",
        "/.claude/skills/worker-pipeline/"
      ],
      "read": [
        "context/worker.md",
        ".claude/agents/worker.md",
        "worker/**",
        "evals/__init__.py",
        "evals/__main__.py",
        "app/**",
        "extractor/**",
        ".claude/skills/worker-pipeline/**"
      ],
      "write": [
        "worker/**",
        "evals/__init__.py",
        "evals/__main__.py"
      ],
      "bash": [
        "python",
        "python3",
        "pytest",
        "python -m pytest",
        "bash .claude/skills/worker-pipeline/scripts/",
        "sqlite3"
      ],
      "gate": "python -c \"import worker.checks, worker.run\""
    },
    "extract": {
      "checkout": [
        "/context/extract.md",
        "/.claude/agents/extract.md",
        "/extractor/"
      ],
      "read": [
        "context/extract.md",
        ".claude/agents/extract.md",
        "extractor/**"
      ],
      "write": [
        "extractor/**"
      ],
      "bash": [
        "python",
        "python3",
        "pytest",
        "python -m pytest"
      ],
      "gate": "python -c \"from extractor import extract\""
    },
    "evals-data": {
      "checkout": [
        "/context/evals-data.md",
        "/.claude/agents/evals-data.md",
        "/evals/notices.jsonl"
      ],
      "read": [
        "context/evals-data.md",
        ".claude/agents/evals-data.md",
        "evals/notices.jsonl"
      ],
      "write": [
        "evals/notices.jsonl"
      ],
      "bash": [],
      "gate": null,
      "_note": "Runs as one no-tools LLM call via scripts/agents.sh evals-call; the clone only receives the committed output."
    },
    "tests": {
      "checkout": [
        "/context/tests.md",
        "/.claude/agents/tests.md",
        "/tests/"
      ],
      "read": [
        "context/tests.md",
        ".claude/agents/tests.md",
        "tests/**"
      ],
      "write": [
        "tests/**"
      ],
      "bash": [],
      "gate": "ast"
    },
    "reviewer": {
      "checkout": [
        "/*"
      ],
      "read": [
        "**"
      ],
      "write": [],
      "bash": [
        "python",
        "python3",
        "pytest",
        "python -m pytest"
      ],
      "gate": null
    }
  }
}
